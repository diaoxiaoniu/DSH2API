DSH2API_KEY=d2a_change_me
DSH2API_HOST=127.0.0.1
DSH2API_PORT=18611

# DeepSeek Harness SDK requires an explicit home directory.
DSH_HOME=/absolute/path/to/.dsh
DSH_PROFILE=sdk
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_REASONING_EFFORT=
DSH_MAX_TOKENS=8192
DSH_WORKSPACE=/absolute/path/to/workspace

# Optional hosted WebUI mode. When set, dsh2api uses the authenticated DSH
# gateway instead of spawning a local Harness runtime.
DSH_REMOTE_URL=
DSH_REMOTE_TIMEOUT=600
